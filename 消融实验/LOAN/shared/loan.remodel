//Contract SubmitLoanRequest::calculateScore Skeleton
	Contract SubmitLoanRequest::calculateScore() : Integer {

		/*
		 * Generated by RM2DOc - Precondition
		 * The object LoanRequest exists
		 * LoanRequest exists
		 * LoanRequest exists
		 */
		precondition:
			self.LoanRequest.oclIsUndefined() = false and
			LoanRequest.RequestedCAHistory.oclIsUndefined() = false and
			LoanRequest.RequestedCreditHistory.oclIsUndefined() = false

		/*
		 * Generated by RM2DOc - Postcondition
		 * The attribute CreditScore of the object LoanRequest became 100
		 * The attribute Status of the object LoanRequest became SUBMITTED
		 * The return value was the attribute CreditScore of the object LoanRequest
		 */
		postcondition:
			// outstandingdebt,  baddebits,  balance,  checkingaccountstatus,  income 
			self.LoanRequest.CreditScore = 100 and
			self.LoanRequest.Status = LoanRequesttatus::SUBMITTED and
			result = self.LoanRequest.CreditScore
	}

