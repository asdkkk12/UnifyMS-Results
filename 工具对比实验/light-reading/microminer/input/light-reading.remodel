  startDate : Date
  endDate : Date
  sortNumber : Integer
  creater : String
  createTime : Date
  updateTime : Date
  updater : String
 }
 Contract ReadingCloudAccountUserBookshelfServiceImpl::ReadingCloudAccountUserBookshelfServiceImplSyncUserBookshelf() : Boolean {
  definition:
   refUserBookshelf : UserBookshelf
  postcondition:
   result = true
 }
