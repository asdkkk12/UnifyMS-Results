 Entity User {
  id : Integer
  uuid : String
  userPwd : String
  loginName : String
  nickName : String
  phoneNumber : String
  headImgUrl : String
  createTime : Date
  updateTime : Date
 }
 Entity UserBookshelf {
  id : Integer
  userId : Integer
  bookId : String
  lastChapterId : Integer
  lastReadTime : Integer
  createTime : Date
 }
 Entity UserLikeSee {
  id : Integer
  userId : Integer
  bookId : String
  createTime : Date
 }
 Entity Book {
  id : Integer
  authorId : Integer
  dicCategory : Integer
  dicChannel : Integer
  dicSerialStatus : Integer
  onlineStatus : String
  bookId : String
  bookName : String
  bookScore : Integer
  keyWord : String
  imgUrl : String
  authorName : String
  introduction : String
  isbn : String
  wordCount : Integer
  creater : String
  createTime : Date
  updateTime : Date
  updater : String
 }
 Entity BookAuthor {
  id : Integer
  name : String
  introduction : String
  headImgUrl : String
  creater : String
  createTime : Date
  updater : String
  updateTime : Date
 }
 Entity BookChapter {
  id : Integer
  bookId : Integer
  name : String
  content : String
  lockStatus : String
  sortNumber : Integer
  createTime : Date
  updateTime : Date
 }
 Entity DataDictionary {
  id : Integer
  dicType : String
  dicTypeName : String
